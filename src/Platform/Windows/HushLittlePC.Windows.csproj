<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>HushLittlePC</RootNamespace>
    <AssemblyName>HushLittlePC.Windows</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.4.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- Overrides the vulnerable System.Drawing.Common 4.7.0 pulled in by the notifications toolkit. -->
    <PackageReference Include="System.Drawing.Common" Version="11.0.0" />
    <ProjectReference Include="..\..\Core\HushLittlePC.Core.csproj" />
    <EmbeddedResource Include="..\..\..\resources\ToastIcon.png" LogicalName="HushLittlePC.ToastIcon.png" />
  </ItemGroup>
</Project>
