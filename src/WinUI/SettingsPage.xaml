<Page
    x:Class="HushLittlePC.WinUI.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="{StaticResource PageContentMaxWidth}"
            Padding="{StaticResource PageContentPadding}"
            Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock Style="{StaticResource PageTitleTextBlockStyle}" Text="Settings" />
            <TextBlock
                Style="{StaticResource PageSubtitleTextBlockStyle}"
                Text="Choose when Hush Little PC mutes your audio and how it responds." />

            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Idle behaviour" />
            <toolkit:SettingsCard
                Description="Minutes without keyboard or mouse activity, from 1 minute to 24 hours."
                Header="Mute after inactivity">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE121;" />
                </toolkit:SettingsCard.HeaderIcon>
                <NumberBox
                    x:Name="IdleMinutesNumberBox"
                    MinWidth="150"
                    AutomationProperties.HelpText="The number of minutes without keyboard or mouse activity before audio is muted."
                    AutomationProperties.Name="Mute after inactivity, in minutes"
                    LargeChange="5"
                    Maximum="1440"
                    Minimum="1"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="IdleMinutesNumberBox_ValueChanged" />
            </toolkit:SettingsCard>

            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Behaviour" />
            <toolkit:SettingsCard Description="Allow automatic muting while you are away." Header="Enable Hush Little PC">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE767;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="EnabledToggle"
                    AutomationProperties.Name="Enable Hush Little PC"
                    Tag="Enabled"
                    Toggled="Setting_Toggled" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Description="Only reverses a mute made by Hush Little PC." Header="Unmute when I come back">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE765;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="UnmuteOnActivityToggle"
                    AutomationProperties.Name="Unmute when I come back"
                    Tag="UnmuteOnActivity"
                    Toggled="Setting_Toggled" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Description="Avoid muting while sound is being output." Header="Stay unmuted while audio is playing">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8D6;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="SkipWhileAudioPlayingToggle"
                    AutomationProperties.Name="Stay unmuted while audio is playing"
                    Tag="SkipWhileAudioPlaying"
                    Toggled="Setting_Toggled" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Description="Mute a newly selected playback device." Header="Mute when the output device changes">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="MuteOnDeviceChangeToggle"
                    AutomationProperties.Name="Mute when the output device changes"
                    Tag="MuteOnDeviceChange"
                    Toggled="Setting_Toggled" />
            </toolkit:SettingsCard>

            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="General" />
            <toolkit:SettingsCard Description="Show a Windows notification when audio is muted." Header="Show mute notifications">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEA8F;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="ShowNotificationToggle"
                    AutomationProperties.Name="Show mute notifications"
                    Tag="ShowNotification"
                    Toggled="Setting_Toggled" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Description="Start Hush Little PC when you sign in to Windows." Header="Run at startup">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE768;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="RunOnStartupToggle"
                    AutomationProperties.Name="Run at startup"
                    Tag="RunOnStartup"
                    Toggled="Setting_Toggled" />
            </toolkit:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
