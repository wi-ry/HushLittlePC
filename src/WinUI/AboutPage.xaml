<Page
    x:Class="HushLittlePC.WinUI.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel
            MaxWidth="820"
            Spacing="20"
            Padding="32,28,32,40"
            HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="About" FontSize="28" FontWeight="SemiBold" />
                <TextBlock
                    Text="Application information and diagnostics."
                    FontSize="14"
                    Opacity="0.72"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Hush Little PC" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock
                        Text="A quiet utility that helps manage audio muting when you step away from your PC."
                        TextWrapping="Wrap"
                        Opacity="0.72" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <TextBlock Text="Version" Opacity="0.72" />
                        <TextBlock x:Name="VersionText" Grid.Column="1" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <TextBlock Text=".NET runtime" Opacity="0.72" />
                        <TextBlock x:Name="RuntimeText" Grid.Column="1" />
                    </Grid>
                    <HyperlinkButton
                        Content="View source on GitHub"
                        NavigateUri="https://github.com/wi-ry/HushLittlePC"
                        HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Diagnostics" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="DiagnosticsText"
                        TextWrapping="Wrap"
                        FontFamily="Consolas"
                        FontSize="12"
                        Opacity="0.82" />
                    <Button
                        Content="Copy diagnostics"
                        HorizontalAlignment="Left"
                        Click="CopyDiagnostics_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
