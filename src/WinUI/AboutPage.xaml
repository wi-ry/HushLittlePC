<Page
    x:Class="HushLittlePC.WinUI.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="{StaticResource PageContentMaxWidth}"
            Padding="{StaticResource PageContentPadding}"
            Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock Style="{StaticResource PageTitleTextBlockStyle}" Text="About" />
            <TextBlock
                Style="{StaticResource PageSubtitleTextBlockStyle}"
                Text="Application information and diagnostics." />

            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Application" />
            <toolkit:SettingsExpander
                x:Name="AppInfoExpander"
                Description="A quiet utility that mutes your audio when you step away from your PC."
                Header="Hush Little PC"
                IsExpanded="True">
                <toolkit:SettingsExpander.HeaderIcon>
                    <ImageIcon x:Name="AppIcon" />
                </toolkit:SettingsExpander.HeaderIcon>
                <TextBlock
                    x:Name="VersionText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource BodyTextBlockStyle}" />
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard Header=".NET runtime">
                        <TextBlock
                            x:Name="RuntimeText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard
                        x:Name="SourceCard"
                        AutomationProperties.HelpText="Opens the project page in your web browser."
                        Click="SourceCard_Click"
                        Header="View source on GitHub"
                        IsClickEnabled="True">
                        <toolkit:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </toolkit:SettingsCard.ActionIcon>
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Diagnostics" />
            <toolkit:SettingsExpander
                Description="Include this information when you report a problem."
                Header="Diagnostic information">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <Button x:Name="CopyDiagnosticsButton" Click="CopyDiagnostics_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="CopyDiagnosticsIcon" FontSize="16" Glyph="&#xE8C8;" />
                        <TextBlock x:Name="CopyDiagnosticsText" Text="Copy" />
                    </StackPanel>
                </Button>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Left">
                        <TextBlock
                            x:Name="DiagnosticsText"
                            FontFamily="Cascadia Mono, Consolas"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
