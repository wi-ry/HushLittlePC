<Page
    x:Class="HushLittlePC.WinUI.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled"
        ZoomMode="Disabled">
        <StackPanel
            MaxWidth="760"
            Spacing="12"
            Padding="28,24,28,32"
            HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="About" FontSize="28" FontWeight="SemiBold" />
                <TextBlock
                    Text="Application information and diagnostics."
                    FontSize="12"
                    Opacity="0.72"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Hush Little PC" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock
                            Text="A quiet utility that helps manage audio muting when you step away from your PC."
                            TextWrapping="Wrap"
                            Opacity="0.72" />
                    </StackPanel>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="12">
                        <TextBlock Text="Version" Opacity="0.72" />
                        <TextBlock x:Name="VersionText" Grid.Column="1" />
                        <TextBlock Text=".NET runtime" Grid.Row="1" Opacity="0.72" />
                        <TextBlock x:Name="RuntimeText" Grid.Row="1" Grid.Column="1" />
                    </Grid>
                    <HyperlinkButton
                        Content="View source on GitHub"
                        NavigateUri="https://github.com/wi-ry/HushLittlePC"
                        HorizontalAlignment="Left"
                        Padding="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="14">
                    <TextBlock Text="Diagnostics" FontSize="16" FontWeight="SemiBold" />
                    <Border
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        CornerRadius="6"
                        Padding="14">
                        <TextBlock
                            x:Name="DiagnosticsText"
                            TextWrapping="Wrap"
                            FontFamily="Consolas"
                            FontSize="11"
                            Opacity="0.82" />
                    </Border>
                    <Button
                        Content="Copy diagnostics"
                        HorizontalAlignment="Left"
                        Click="CopyDiagnostics_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
