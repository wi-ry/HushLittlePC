<Page
    x:Class="HushLittlePC.WinUI.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel
        MaxWidth="760"
        Spacing="16"
        Padding="32,28,32,40"
        HorizontalAlignment="Left">
        <TextBlock
            Text="About"
            Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock
            Text="Hush Little PC"
            Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock
            Text="A quiet utility that helps manage audio muting when you step away from your PC."
            Style="{StaticResource BodyTextBlockStyle}"
            TextWrapping="Wrap"
            Opacity="0.72" />
        <InfoBar
            IsOpen="True"
            IsClosable="False"
            Severity="Informational"
            Title="Migration in progress"
            Message="The WinUI version is being introduced alongside the existing application. Version and diagnostics details will be connected in a later stage." />
    </StackPanel>
</Page>
