<Application
    x:Class="HushLittlePC.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Layout values follow the Windows Settings / WinUI Gallery settings pattern. -->
            <x:Double x:Key="SettingsCardSpacing">4</x:Double>
            <x:Double x:Key="PageContentMaxWidth">1000</x:Double>
            <Thickness x:Key="PageContentPadding">36,0,36,36</Thickness>

            <!-- Section header above a group of settings cards. -->
            <Style
                x:Key="SettingsSectionHeaderTextBlockStyle"
                BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Margin" Value="1,30,0,6" />
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
            </Style>

            <!-- Page title, sized to align with the NavigationView header. -->
            <Style
                x:Key="PageTitleTextBlockStyle"
                BasedOn="{StaticResource TitleTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Margin" Value="0,24,0,4" />
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
            </Style>

            <Style
                x:Key="PageSubtitleTextBlockStyle"
                BasedOn="{StaticResource BodyTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
