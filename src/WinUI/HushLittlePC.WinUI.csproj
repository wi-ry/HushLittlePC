<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>HushLittlePC.WinUI</RootNamespace>
    <AssemblyName>HushLittlePC.WinUI</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <ProjectReference Include="..\Core\HushLittlePC.Core.csproj" />
    <ProjectReference Include="..\Platform\Windows\HushLittlePC.Windows.csproj" />
  </ItemGroup>
</Project>
