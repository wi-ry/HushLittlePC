<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>HushLittlePC.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>HushLittlePC.WinUI</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Unpackaged toasts register their app group name and icon from the exe metadata. -->
    <ApplicationIcon>..\..\packaging\app.ico</ApplicationIcon>
    <Product>Hush Little PC</Product>
    <AssemblyTitle>Hush Little PC</AssemblyTitle>
    <!--
      Compiled XAML lives in the app's PRI file. Unpackaged apps look for "<exe name>.pri" and fall
      back to "resources.pri"; packaged apps always use "resources.pri". The release renames the
      standalone exe (HushLittlePC_<version>_x64.exe), so a PRI named after the assembly is
      not found and MainWindow fails with XamlParseException. resources.pri works for every exe
      name and for MSIX.
    -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
  </PropertyGroup>
  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="..\..\packaging\app.ico" Link="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.15" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <ProjectReference Include="..\Core\HushLittlePC.Core.csproj" />
    <ProjectReference Include="..\Platform\Windows\HushLittlePC.Windows.csproj" />
  </ItemGroup>
</Project>
