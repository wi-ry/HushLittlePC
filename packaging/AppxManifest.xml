<?xml version="1.0" encoding="utf-8"?>
<!-- Tokens in {{double braces}} are filled in by .github/scripts/package-msix.ps1 -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap com desktop">

  <Identity Name="{{IDENTITY_NAME}}"
            Publisher="{{PUBLISHER}}"
            Version="{{VERSION}}"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Hush Little PC</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="HushLittlePC" Executable="HushLittlePC.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Hush Little PC"
        Description="Mutes your speakers after a period of inactivity."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Packaged apps can't use the HKCU Run key; this is the MSIX way to start with Windows. -->
        <uap5:Extension Category="windows.startupTask" Executable="HushLittlePC.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="HushLittlePCStartup" Enabled="false" DisplayName="Hush Little PC" />
        </uap5:Extension>

        <!-- Lets the Unmute button on notifications reach the app (Windows starts/targets HushLittlePC.exe) -->
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="34B9CB82-69D0-4942-8044-7A0A1D5B37A3" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="HushLittlePC.exe" Arguments="-ToastActivated" DisplayName="Hush Little PC toast activator">
              <com:Class Id="34B9CB82-69D0-4942-8044-7A0A1D5B37A3" DisplayName="Hush Little PC toast activator" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
