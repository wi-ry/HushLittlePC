<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HushLittlePC</AssemblyName>
    <Version>1.0.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>packaging\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="resources\ToastIcon.png" LogicalName="HushLittlePC.ToastIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="src\WinUI\**\*.cs" />
    <Compile Remove="src\Core\**\*.cs" />
    <Compile Remove="src\Platform\Windows\**\*.cs" />
    <Compile Remove="src\UI\NativeMenu.cs" />
    <Compile Remove="src\UI\Notifier.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="src\Core\HushLittlePC.Core.csproj" />
    <ProjectReference Include="src\Platform\Windows\HushLittlePC.Windows.csproj" />
  </ItemGroup>
</Project>
